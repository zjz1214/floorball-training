{
  "name": "training-manual",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "软曲教学 - 软式曲棍球（Floorball）校队训练内容网站",
  "scripts": {
    "desktop": "electron .desktop/main.cjs",
    "desktop:build": "node .desktop/build.mjs",
